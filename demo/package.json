{
  "name": "@jankrajewskiit/ui-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --force",
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "preview": "vite preview"
  },
  "dependencies": {
    "@jankrajewskiit/ui": "file:..",
    "@solidjs/router": "^0.15.4",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.11",
    "solid-markdown": "^2.1.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10"
  }
}
