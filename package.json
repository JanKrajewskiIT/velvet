{
  "name": "@jankrajewskiit/ui",
  "version": "3.6.5",
  "description": "SolidJS component library with theming and translations.",
  "keywords": [
    "solidjs",
    "solid",
    "ui",
    "components",
    "component-library"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvet.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./common": {
      "types": "./dist/common.d.mts",
      "import": "./dist/common.mjs"
    },
    "./bare": {
      "types": "./dist/bare.d.mts",
      "import": "./dist/bare.mjs"
    },
    "./patterns": {
      "types": "./dist/patterns.d.mts",
      "import": "./dist/patterns.mjs"
    },
    "./styles/*": {
      "types": "./styles.d.ts",
      "default": "./dist/styles/presets/*.css"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/velvet-ui.css"
    }
  },
  "types": "./dist/index.d.mts",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@12.2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist/**/*",
    "styles.d.ts"
  ],
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build && configs-package-styles",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix --max-warnings 0",
    "verify": "npm run toolchain && npm run editor:check && npm run format:check && npm run lint && npm run quality:check && npm run lint:css && npm run build && npm run verify:pkg && npm run size",
    "verify:pkg": "npm run verify:types && publint --strict && attw --pack . --entrypoints . ./bare ./common ./patterns --profile esm-only",
    "size": "size-limit",
    "prepare": "husky",
    "toolchain": "configs-toolchain",
    "audit:deps": "configs-audit",
    "prebuild": "npm run toolchain",
    "verify:types": "tsc -p tsconfig.declarations.json",
    "editor:sync": "configs-editor --write",
    "editor:check": "configs-editor",
    "deps:check": "knip --no-exit-code --reporter json",
    "deps:strict": "configs-unused",
    "architecture:check": "configs-architecture",
    "duplicates:report": "configs-duplicates",
    "quality:check": "npm run architecture:check && npm run duplicates:report && npm run deps:strict"
  },
  "peerDependencies": {
    "@jankrajewskiit/auth": "^3.6.4",
    "@jankrajewskiit/i18n": ">=3.6.4 <4",
    "solid-js": ">=1.9.0 <2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jankrajewskiit/auth": "^3.6.4",
    "@jankrajewskiit/configs": "^3.6.6",
    "@jankrajewskiit/i18n": "^3.6.4",
    "@size-limit/file": "^14.2.0",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "solid-js": "^1.9.17",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vite": "^8.3.4",
    "dependency-cruiser": "^18.6.0",
    "jscpd": "~5.4.1"
  },
  "size-limit": [
    {
      "path": "dist/**/*.mjs",
      "limit": "480 kB",
      "name": "Published JavaScript (all modules)"
    },
    {
      "path": "dist/velvet-ui.css",
      "limit": "275 kB"
    }
  ],
  "overrides": {
    "eslint": "$eslint"
  }
}
