{
  "name": "@jankrajewskiit/ui",
  "version": "1.3.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvet.git"
  },
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/velvet-ui.css",
    "./eslint-config": "./config/eslint.mjs",
    "./prettier-config": "./config/prettier.json",
    "./tsconfig/app": "./config/tsconfig.app.json",
    "./tsconfig/node": "./config/tsconfig.node.json",
    "./tsconfig/app-vite": "./config/tsconfig.app-vite.json",
    "./tsconfig/node-vite": "./config/tsconfig.node-vite.json",
    "./vite-config": {
      "types": "./config/vite.d.mts",
      "import": "./config/vite.mjs"
    },
    "./lint-staged-config": {
      "types": "./config/lint-staged.d.mts",
      "import": "./config/lint-staged.mjs"
    },
    "./husky/pre-commit": "./config/husky-pre-commit.sh",
    "./stylelint-config": "./config/stylelint.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@11.12.0",
  "files": [
    "dist",
    "config"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsc -p tsconfig.test.json && node --test .tmp-tests/tests/*.test.js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run build && npm run test && npm run verify:pkg",
    "verify:pkg": "publint && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "size": "size-limit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@solidjs/router": ">=0.15",
    "lightweight-charts": ">=5.1.0",
    "solid-icons": ">=1.2.0",
    "solid-js": ">=1.9",
    "solid-markdown": ">=2.1.0",
    "stylelint": ">=17",
    "stylelint-config-standard": ">=40"
  },
  "peerDependenciesMeta": {
    "@solidjs/router": {
      "optional": true
    },
    "lightweight-charts": {
      "optional": true
    },
    "solid-icons": {
      "optional": true
    },
    "solid-markdown": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    },
    "stylelint-config-standard": {
      "optional": true
    }
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^12.0.1",
    "@solidjs/router": "^0.16.1",
    "@types/node": "^25.5.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lightweight-charts": "^5.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "publint": "^0.3.18",
    "size-limit": "^12.0.1",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.12",
    "solid-markdown": "^2.1.1",
    "stylelint": "^17.5.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.11.11"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 kB"
    },
    {
      "path": "dist/style.css",
      "limit": "50 kB"
    }
  ],
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-solid": {
      "eslint": "$eslint"
    }
  }
}
