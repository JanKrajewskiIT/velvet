{
  "name": "@jankrajewskiit/ui",
  "version": "3.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvet.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./styles.d.ts",
      "default": "./dist/velvet-ui.css"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@12.2.0",
  "files": [
    "dist/**/*",
    "styles.d.ts"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run build && npm run verify:pkg",
    "verify:pkg": "publint && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "size": "size-limit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@jankrajewskiit/i18n": "^2.0.9",
    "solid-js": ">=1.9"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/compat": "^2.1.1",
    "@jankrajewskiit/configs": "^3.2.0",
    "@jankrajewskiit/i18n": "2.0.9",
    "@size-limit/file": "^14.1.0",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "size-limit": "^14.1.0",
    "solid-js": "^1.9.17",
    "stylelint": "^17.16.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 kB"
    },
    {
      "path": "dist/velvet-ui.css",
      "limit": "50 kB"
    }
  ]
}
