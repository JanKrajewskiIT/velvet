{
  "name": "@jankrajewskiit/ui",
  "version": "2.0.6",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanKrajewskiIT/velvet.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "types": "./config/styles.d.ts",
      "default": "./dist/velvet-ui.css"
    },
    "./eslint-config": "./config/eslint.mjs",
    "./prettier-config": "./config/prettier.json",
    "./tsconfig/app": "./config/tsconfig.app.json",
    "./tsconfig/node": "./config/tsconfig.node.json",
    "./tsconfig/app-vite": "./config/tsconfig.app-vite.json",
    "./tsconfig/node-vite": "./config/tsconfig.node-vite.json",
    "./vite-config": {
      "types": "./config/vite.d.mts",
      "import": "./config/vite.mjs"
    },
    "./lint-staged-config": {
      "types": "./config/lint-staged.d.mts",
      "import": "./config/lint-staged.mjs"
    },
    "./husky/pre-commit": "./config/husky-pre-commit.sh",
    "./stylelint-config": "./config/stylelint.json",
    "./nginx/spa": "./config/nginx-spa.conf"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "npm@11.12.1",
  "files": [
    "dist/**/*",
    "config/**/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepublishOnly": "npm run verify",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "verify": "npm run typecheck && npm run lint && npm run lint:css && npm run build && npm run verify:pkg",
    "verify:pkg": "npm run build && publint && attw --pack . --entrypoints . --profile esm-only --ignore-rules internal-resolution-error",
    "size": "size-limit",
    "prepare": "husky"
  },
  "peerDependencies": {
    "@solidjs/router": ">=0.15",
    "lightweight-charts": ">=5.1.0",
    "oidc-client-ts": ">=3.1.0",
    "solid-icons": ">=1.2.0",
    "solid-js": ">=1.9",
    "solid-markdown": ">=2.1.0",
    "stylelint": ">=17"
  },
  "peerDependenciesMeta": {
    "@solidjs/router": {
      "optional": true
    },
    "lightweight-charts": {
      "optional": true
    },
    "oidc-client-ts": {
      "optional": true
    },
    "solid-icons": {
      "optional": true
    },
    "solid-markdown": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint/js": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "remark-gfm": "^4.0.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.58.2",
    "vite-plugin-solid": "^2.11.12"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@size-limit/file": "^12.1.0",
    "@solidjs/router": "^0.16.1",
    "@types/node": "^25.6.0",
    "eslint": "^9.38.0",
    "husky": "^9.1.7",
    "lightweight-charts": "^5.1.0",
    "lint-staged": "^16.4.0",
    "oidc-client-ts": "^3.5.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.18",
    "size-limit": "^12.1.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.12",
    "solid-markdown": "^2.1.1",
    "stylelint": "^17.8.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.9",
    "vite-plugin-dts": "^4.5.4"
  },
  "overrides": {
    "@eslint/js": "$@eslint/js",
    "eslint": "$eslint"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "100 kB"
    },
    {
      "path": "dist/velvet-ui.css",
      "limit": "50 kB"
    }
  ]
}
