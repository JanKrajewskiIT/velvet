{
  "extends": "./config/tsconfig.node.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "noEmit": false,
    "outDir": "./.tmp-tests",
    "rootDir": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "allowImportingTsExtensions": false,
    "declaration": false,
    "emitDeclarationOnly": false,
    "types": ["node"]
  },
  "include": [
    "src/utils/**/*.ts",
    "src/http/**/*.ts",
    "src/store/**/*.ts",
    "src/query/**/*.ts",
    "src/query/**/*.tsx",
    "src/auth/**/*.ts",
    "tests/**/*.ts"
  ]
}
